# Hostinger (LiteSpeed/Apache) — configuration PWA

# Types MIME corrects
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType font/woff2 .woff2
AddType model/gltf-binary .glb
AddType application/octet-stream .hdr

<IfModule mod_headers.c>
  # Service worker : jamais en cache (sinon les mises à jour ne sont pas détectées)
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Code : toujours revalidé auprès du serveur (ETag → 304 si inchangé, donc léger)
  <FilesMatch "\.(html|js|css|webmanifest|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Assets lourds : cache long (le SW gère les mises à jour)
  <FilesMatch "\.(jpg|png|hdr|glb|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Une PWA exige HTTPS. Activez le SSL dans hPanel puis décommentez :
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
